{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "node --test tests/frontend/*.test.mjs",
        "test:browser": "playwright test",
        "build": "vite build && npm run build:ui",
        "build:ui": "vite build --config vite.ui.config.js --mode helpers && vite build --config vite.ui.config.js --mode core",
        "dev": "vite"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@popperjs/core": "2.11.8",
        "@tailwindcss/vite": "^4.0.0",
        "bootstrap": "5.3.3",
        "concurrently": "^9.0.1",
        "datatables.net": "1.13.8",
        "datatables.net-bs5": "1.13.8",
        "jquery": "3.7.1",
        "laravel-vite-plugin": "^3.1",
        "perfect-scrollbar": "1.5.6",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
